<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewModels="clr-namespace:CowCount.ViewModels">
    <DataTemplate x:Key="CowItemTemplate" DataType="{x:Type viewModels:CowViewModel}">
        <StackPanel>
            <Label Content="{Binding Number}"
                   Padding="0"/>
            <StackPanel Orientation="Horizontal">
                <Label Content="Коровник"
                       Padding="0"
                       Foreground="DarkGray"/>
                <Label Content="{Binding BarnNumber}"
                       Padding="1,0,5,0"/>
                <Label Content="Секция"
                       Padding="0"
                       Foreground="DarkGray"/>
                <Label Content="{Binding SectionNumber}"
                       Padding="1,0"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="SectionItemTemplate" DataType="{x:Type viewModels:SectionViewModel}">
        <StackPanel>
            <Label Content="{Binding Number}"
               Padding="0"/>
            <Label Content="{Binding Group}"
               Padding="0"
               Foreground="DarkGray"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewModels:MoveCowsDialogWindowViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <Label Content="Номера коров для перемещения"/>
                <ListView ItemsSource="{Binding Cows}"
                          ItemTemplate="{StaticResource CowItemTemplate}"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Label Content="Номер нового коровника"/>
                <ListView ItemsSource="{Binding Barns}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="Номер новой секции"/>
                <ListView ItemsSource="{Binding Sections}"
                          ItemTemplate="{StaticResource SectionItemTemplate}"/>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>