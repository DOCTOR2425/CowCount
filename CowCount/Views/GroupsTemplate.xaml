<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewModels="clr-namespace:CowCount.ViewModels">
    <DataTemplate x:Key="GroupItemTemplate">
        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Text="{Binding}" Width="150"/>
            <Button Content="Редактировать"
                    Command="{Binding DataContext.EditGroupCommand,
                              RelativeSource={RelativeSource AncestorType=ListView}}"
                    CommandParameter="{Binding}"/>
            <Button Content="Удалить"
                    Command="{Binding DataContext.DeleteGroupCommand,
                              RelativeSource={RelativeSource AncestorType=ListView}}"
                    CommandParameter="{Binding}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewModels:GroupsViewModel}">
        <StackPanel Margin="10">
            <Button Content="Добавить группу"
                    Command="{Binding AddGroupCommand}" />

            <ListView ItemsSource="{Binding Groups}"
                      ItemTemplate="{StaticResource GroupItemTemplate}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>