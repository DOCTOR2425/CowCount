<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewModels="clr-namespace:CowCount.ViewModels">
    <DataTemplate DataType="{x:Type viewModels:AddGroupDialogWindowViewModel}">
        <StackPanel>
            <Label Content="Введите название группы"
                   Padding="0"/>
            <TextBox Padding="0"
                     Text="{Binding GroupName}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>