<Window x:Class="CowCount.Views.ModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:CowCount.ViewModels"
        Title="{Binding Title}"
        mc:Ignorable="d"
        SizeToContent="WidthAndHeight"
        Width="{Binding Width, Mode=OneWay}"
        MinWidth="{Binding MinWidth, Mode=OneWay}"
        MaxWidth="{Binding MaxWidth, Mode=OneWay}"
        Height="{Binding Height, Mode=OneWay}"
        MinHeight="{Binding MinHeight, Mode=OneWay}"
        MaxHeight="{Binding MaxHeight, Mode=OneWay}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="{Binding ResizeMode, Mode=OneWay}"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        d:DataContext="{d:DesignInstance {x:Type viewModels:DialogViewModel}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DialogTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <ContentControl Grid.Row="0"
                            Margin="8"
                            Content="{Binding}" />
        </Grid>
        <Border Grid.Row="1"
                BorderThickness="0,1,0,0" />
        <Grid Grid.Row="2"
              Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1"
                    MinWidth="80"
                    Content="ОК"
                    HorizontalAlignment="Right"
                    Command="{Binding OkCommand}" />
            <Button Grid.Column="2"
                    MinWidth="80"
                    Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Margin="10,0,0,0" />
        </Grid>
    </Grid>
</Window>
