<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:viewModels="clr-namespace:CowCount.ViewModels">
    <Style x:Key="MoveButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Padding" Value="10,3,10,7"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <DataTemplate x:Key="CowItemTemplate" DataType="{x:Type viewModels:CowViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding Number}"
                   Padding="0"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Коровник"
                           Padding="0"
                           Foreground="DarkGray"/>
                <TextBlock Text="{Binding BarnNumber}"
                           Padding="1,0,5,0"/>
                <TextBlock Text="Секция"
                           Padding="0"
                           Foreground="DarkGray"/>
                <TextBlock Text="{Binding SectionNumber}"
                           Padding="1,0"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="SectionItemTemplate" DataType="{x:Type viewModels:SectionViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding Number}"
                       Padding="0"/>
            <TextBlock Text="{Binding Group}"
                       Padding="0"
                       Foreground="DarkGray"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewModels:MoveCowsViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Откуда"/>
            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Text="Куда"/>

            <ComboBox Grid.Row="1"
                      Grid.Column="0"
                      ItemsSource="{Binding SourceBarns}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding SourceBarnSelectionChangedCommand}"
                            CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>
            <ComboBox Grid.Row="1"
                      Grid.Column="2"
                      ItemsSource="{Binding TargetBarns}"
                      SelectedItem="{Binding SelectedTargetBarn}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding TargetBarnSelectionChangedCommand}"
                            CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>

            <ComboBox Grid.Row="2"
                      Grid.Column="0"
                      ItemsSource="{Binding SourceSections}"
                      ItemTemplate="{StaticResource SectionItemTemplate}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding SourceSectionSelectionChangedCommand}"
                            CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>
            <ComboBox Grid.Row="2"
                      Grid.Column="2"
                      ItemsSource="{Binding TargetSections}"
                      ItemTemplate="{StaticResource SectionItemTemplate}"
                      SelectedItem="{Binding SelectedTargetSection}"/>

            <ListView Grid.Row="4"
                      Grid.Column="0"
                      ItemsSource="{Binding SourceCows}"
                      SelectedItem="{Binding SelectedLeftCow}"
                      ItemTemplate="{StaticResource CowItemTemplate}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding MoveCowRightCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListView>
            <ListView Grid.Row="4"
                      Grid.Column="2"
                      ItemsSource="{Binding TargetCows}"
                      SelectedItem="{Binding SelectedRightCow}"
                      ItemTemplate="{StaticResource CowItemTemplate}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding MoveCowLeftCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListView>

            <Grid Grid.Column="1"
                  Grid.Row="4"
                  Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Grid.Column="0"
                        Content="&gt;"
                        Style="{StaticResource MoveButtonStyle}"
                        Command="{Binding MoveCowRightCommand}"/>
                <Button Grid.Row="1"
                        Grid.Column="0"
                        Content="&lt;"
                        Style="{StaticResource MoveButtonStyle}"
                        Command="{Binding MoveCowLeftCommand}"/>
                <Button Grid.Row="2"
                        Grid.Column="0"
                        Content="&gt;&gt;"
                        Style="{StaticResource MoveButtonStyle}"
                        Command="{Binding MoveAllCowsRightCommand}"/>
                <Button Grid.Row="3"
                        Grid.Column="0"
                        Content="&lt;&lt;"
                        Style="{StaticResource MoveButtonStyle}"
                        Command="{Binding MoveAllCowsLeftCommand}"/>

                <Button Grid.Row="4"
                        Grid.ColumnSpan="2"
                        Content="Переместить"
                        Style="{StaticResource MoveButtonStyle}"
                        Command="{Binding MoveSelectedCowsCommand}"/>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>