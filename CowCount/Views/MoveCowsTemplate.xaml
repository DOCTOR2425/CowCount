<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:viewModels="clr-namespace:CowCount.ViewModels">
    <DataTemplate x:Key="CowItemTemplate" DataType="{x:Type viewModels:CowViewModel}">
        <StackPanel>
            <Label Content="{Binding Number}"
                   Padding="0"/>
            <StackPanel Orientation="Horizontal">
                <Label Content="Коровник"
                       Padding="0"
                       Foreground="DarkGray"/>
                <Label Content="{Binding BarnNumber}"
                       Padding="1,0,5,0"/>
                <Label Content="Секция"
                       Padding="0"
                       Foreground="DarkGray"/>
                <Label Content="{Binding SectionNumber}"
                       Padding="1,0"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="SectionItemTemplate" DataType="{x:Type viewModels:SectionViewModel}">
        <StackPanel>
            <Label Content="{Binding Number}"
               Padding="0"/>
            <Label Content="{Binding Group}"
               Padding="0"
               Foreground="DarkGray"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewModels:MoveCowsViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0"
                   Grid.Column="0"
                   Content="Откуда"/>
            <Label Grid.Row="0"
                   Grid.Column="2"
                   Content="Куда"/>

            <ComboBox Grid.Row="1"
                      Grid.Column="0"
                      ItemsSource="{Binding SourceBarns}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding SourceBarnSelectionChangedCommand}"
                            CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>
            <ComboBox Grid.Row="1"
                      Grid.Column="2"
                      ItemsSource="{Binding TargetBarns}"/>

            <ComboBox Grid.Row="2"
                      Grid.Column="0"
                      ItemsSource="{Binding SourceSections}"
                      ItemTemplate="{StaticResource SectionItemTemplate}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding SourceSectionSelectionChangedCommand}"
                            CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>
            <ComboBox Grid.Row="2"
                      Grid.Column="2"
                      ItemsSource="{Binding TargetSections}"
                      ItemTemplate="{StaticResource SectionItemTemplate}"/>

            <ListView Grid.Row="4"
                      Grid.Column="0"
                      ItemsSource="{Binding SourceCows}"
                      ItemTemplate="{StaticResource CowItemTemplate}"/>
            <ListView Grid.Row="4"
                      Grid.Column="2"
                      ItemsSource="{Binding TargetCows}"
                      ItemTemplate="{StaticResource CowItemTemplate}"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>