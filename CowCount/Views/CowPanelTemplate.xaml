<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewModels="clr-namespace:CowCount.ViewModels">
    <DataTemplate DataType="{x:Type viewModels:CowPanelViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">

                <TextBlock Text="Идентификация" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Номер:" 
                           VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" 
                           Text="{Binding Cow.Number, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="Пол:" 
                           VerticalAlignment="Center"/>
                    <ComboBox  Grid.Row="1" Grid.Column="1" 
                           SelectedIndex="{Binding Cow.Gender}"
                           Margin="0,2">
                        <ComboBoxItem Content="Корова"/>
                        <ComboBoxItem Content="Бык"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" 
                           Text="Порода:" 
                           VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" 
                           Text="{Binding Cow.Breed, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,2"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" 
                           Text="Группа:" 
                           VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" 
                           Text="{Binding Cow.Group, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,2"/>

                    <CheckBox  Grid.Row="4" Grid.Column="1" 
                           Content="Импортная"
                           IsChecked="{Binding Cow.Imported}"
                           Margin="0,5"/>
                </Grid>

                <Separator Margin="0,10"/>

                <TextBlock Text="Расположение" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Коровник:" 
                           VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" 
                           Text="{Binding Cow.BarnNumber}"
                           IsReadOnly="True"
                           Background="#F0F0F0"
                           Margin="0,2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="Секция:" 
                           VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" 
                           Text="{Binding Cow.SectionNumber}"
                           IsReadOnly="True"
                           Background="#F0F0F0"
                           Margin="0,2"/>
                </Grid>

                <Separator Margin="0,10"/>

                <TextBlock Text="Даты" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Дата рождения:" 
                           VerticalAlignment="Center"/>
                    <DatePicker Grid.Row="0" Grid.Column="1" 
                            SelectedDate="{Binding Cow.Birthday}"
                            Margin="0,2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="Дата смерти:" 
                           VerticalAlignment="Center"/>
                    <DatePicker Grid.Row="1" Grid.Column="1" 
                            SelectedDate="{Binding Cow.DeathDate}"
                            Margin="0,2"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" 
                           Text="Осеменение:" 
                           VerticalAlignment="Center"/>
                    <DatePicker Grid.Row="2" Grid.Column="1" 
                            SelectedDate="{Binding Cow.LastInseminationDate}"
                            Margin="0,2"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" 
                           Text="Отёл:" 
                           VerticalAlignment="Center"/>
                    <DatePicker Grid.Row="3" Grid.Column="1" 
                            SelectedDate="{Binding Cow.LastCalvingDate}"
                            Margin="0,2"/>
                </Grid>

                <Separator Margin="0,10"/>

                <TextBlock Text="Разведение" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                           Text="Бык-производитель:" 
                           VerticalAlignment="Center"/>
                    <TextBox   Grid.Column="1" 
                           Text="{Binding Cow.SpermDonorNickname, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,2"/>
                </Grid>

                <Separator Margin="0,10"/>

                <TextBlock Text="Заметки" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"/>
                <TextBox Text="{Binding Cow.Note, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="60"
                     VerticalScrollBarVisibility="Auto"/>

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>