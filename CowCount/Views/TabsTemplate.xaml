<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:viewModels="clr-namespace:CowCount.ViewModels">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="MainViewModelTemplate.xaml" />
        <ResourceDictionary Source="GroupsTemplate.xaml" />
        <ResourceDictionary Source="MoveCowsTemplate.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <DataTemplate DataType="{x:Type viewModels:TabsViewModel}">
        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Основное">
                <ContentControl Content="{Binding MainViewModel}" />
            </TabItem>

            <TabItem Header="Группы">
                <ContentControl Content="{Binding GroupsViewModel}" />
            </TabItem>
            
            <TabItem Header="Перемещение"
                     IsSelected="{Binding MoveCowsViewModel.IsSelected}"
                     >
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Selected">
                        <i:InvokeCommandAction Command="{Binding MoveCowsViewModel.ActivatedCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <ContentControl Content="{Binding MoveCowsViewModel}" />
            </TabItem>
        </TabControl>
    </DataTemplate>

</ResourceDictionary>